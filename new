<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>NHI PROBE — Cybernetic Interface</title>
<style>
    body {
        margin: 0;
        padding: 0;
        background: black;
        color: #00eaff;
        font-family: 'Courier New', monospace;
        overflow: hidden;
    }

    /* Animated scanlines */
    .scanlines {
        pointer-events: none;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: repeating-linear-gradient(
            to bottom,
            rgba(0, 255, 255, 0.05) 0px,
            rgba(0, 255, 255, 0.05) 2px,
            transparent 3px,
            transparent 6px
        );
        animation: flicker 0.2s infinite;
    }

    @keyframes flicker {
        0% { opacity: 0.2; }
        50% { opacity: 0.35; }
        100% { opacity: 0.2; }
    }

    /* Glitch title */
    .title {
        font-size: 3.5rem;
        text-align: center;
        margin-top: 80px;
        text-shadow: 0 0 10px #00eaff, 0 0 20px #00eaff;
        animation: glitch 1.5s infinite;
    }

    @keyframes glitch {
        0% { transform: skew(0deg); }
        20% { transform: skew(3deg); }
        40% { transform: skew(-3deg); }
        60% { transform: skew(2deg); }
        80% { transform: skew(-2deg); }
        100% { transform: skew(0deg); }
    }

    /* Neon grid background */
    .grid {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background:
            linear-gradient(#00eaff22 1px, transparent 1px),
            linear-gradient(90deg, #00eaff22 1px, transparent 1px);
        background-size: 40px 40px;
        animation: gridmove 10s linear infinite;
        z-index: -1;
    }

    @keyframes gridmove {
        from { transform: translateY(0); }
        to { transform: translateY(40px); }
    }

    /* Terminal typing box */
    .terminal {
        width: 80%;
        margin: 60px auto;
        padding: 20px;
        border: 2px solid #00eaff;
        box-shadow: 0 0 20px #00eaff;
        background: rgba(0, 0, 0, 0.6);
        font-size: 1.2rem;
        min-height: 200px;
    }

    .cursor {
        display: inline-block;
        width: 10px;
        background: #00eaff;
        animation: blink 0.7s infinite;
    }

    @keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
    }
</style>
</head>

<body>

<div class="grid"></div>

<h1 class="title">NHI PROBE INTERFACE</h1>

<div class="terminal" id="terminal">
    <span id="text"></span><span class="cursor"></span>
</div>

<div class="scanlines"></div>

<script>
const messages = [
    "BOOTING NHI PROBE SYSTEM...",
    "ESTABLISHING LINK...",
    "SCANNING UNKNOWN SIGNATURES...",
    "ANALYZING NON-HUMAN INTELLIGENCE PATTERNS...",
    "READY."
];

let index = 0;
let charIndex = 0;
let current = "";
let speed = 50;

function type() {
    if (charIndex < messages[index].length) {
        current += messages[index][charIndex++];
        document.getElementById("text").innerText = current;
        setTimeout(type, speed);
    } else {
        setTimeout(() => {
            index++;
            if (index < messages.length) {
                current = "";
                charIndex = 0;
                document.getElementById("text").innerText = "";
                type();
            }
        }, 800);
    }
}

type();
</script>

</body>
</html>
